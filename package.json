{
  "name": "newscred-rag",
  "version": "1.0.0",
  "description": "News verification app with source credential scoring, RAG evidence retrieval, verdicts, tests, and documentation.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:verification": "node --test tests/credentials.test.js tests/rag.test.js tests/text.test.js tests/verifier.test.js",
    "validate": "npm run test"
  },
  "keywords": [
    "news",
    "fact-checking",
    "rag",
    "verification",
    "journalism"
  ],
  "license": "UNLICENSED"
}
